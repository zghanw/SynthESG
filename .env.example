# ==================================================================
# SynthESG — Environment Variables
#
# Copy this file to .env and add your Tavily key:
#   cp .env.example .env
# ==================================================================

# --- Tavily API (required) ---
# Get your free key at https://tavily.com — 1,000 credits/month free
TAVILY_API_KEY=your_tavily_api_key_here

# --- AWS (only needed for production CDK deployment) ---
AWS_REGION=ap-southeast-5
S3_REPORTS_BUCKET=
